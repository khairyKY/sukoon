<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build: Play updates the app (no installing its own updates), and exact alarms are
     asked for (Settings → Alarms & reminders) instead of claimed as an alarm-clock app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:remove="android:maxSdkVersion" />
</manifest>
