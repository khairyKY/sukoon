    <!-- Trends → Insights -->
    <string name="insights_title">Insights</string>
    <string name="insights_tab">Insights</string>
    <string name="insights_banner">Patterns from your own data and published research. Not medical advice — you decide, ideally with your diabetes team.</string>
    <string name="insights_ack_title">Before you use Insights</string>
    <string name="insights_ack_body">Sukoon looks for patterns in your readings and logbook and compares them with published clinical targets and formulas. It doesn\'t diagnose or prescribe, it doesn\'t know your whole situation, and it can be wrong — sensors drift and logs miss things.\n\nNothing here tells you to change a dose. Any change to insulin, food or activity is your own decision and responsibility, ideally made with your diabetes team. If you feel unwell or you\'re low, treat first and get help.</string>
    <string name="insights_ack_button">I understand</string>
    <string name="insight_discuss_label">OFTEN DISCUSSED WITH YOUR CARE TEAM</string>
    <string name="insight_source">Source: %1$s</string>
    <string name="insight_nodata_title">Not enough data yet</string>
    <string name="insight_nodata_body">%1$d days with sensor data, %2$d%% coverage. Insights start at 3 days and 50%%; the international consensus uses 14 days at 70%% or more.</string>
    <string name="insight_tir_title">Time in ranges · last %1$d days</string>
    <string name="insight_tir_in_range">In range 70–180</string>
    <string name="insight_tir_below70">Below 70</string>
    <string name="insight_tir_below54">Below 54</string>
    <string name="insight_tir_above180">Above 180</string>
    <string name="insight_tir_above250">Above 250</string>
    <string name="insight_goal_over">goal over %1$d%%</string>
    <string name="insight_goal_under">goal under %1$d%%</string>
    <string name="insight_tir_mean">Average %1$d mg/dL · estimated A1C (GMI) %2$s%%</string>
    <string name="insight_tir_coverage">Based on %1$d days at %2$d%% sensor coverage. The consensus uses 14 days at 70%%+, so treat this as early.</string>
    <string name="insight_cv_title">Stability</string>
    <string name="insight_cv_good">Coefficient of variation %1$d%% — at or under 36%% is considered stable.</string>
    <string name="insight_cv_high">Coefficient of variation %1$d%% — above 36%% is considered unstable, and big swings make lows more likely.</string>
    <string name="insight_cv_discuss">Swings usually trace back to meal size and timing, insulin timing, and corrections. Steadying those tends to steady the line.</string>
    <string name="insight_lows_title">Lows around %1$s–%2$s</string>
    <string name="insight_lows_body">Below 70 for 15+ minutes on %1$d different days in this window (%2$d of your %3$d lows in 14 days).</string>
    <string name="insight_lows_discuss_night">Repeating overnight lows are commonly reviewed together with the basal (long-acting) dose and any evening corrections.</string>
    <string name="insight_lows_discuss_day">Repeating daytime lows are commonly reviewed with the meal or correction doses taken 2–4 hours before, and with activity.</string>
    <string name="insight_highs_title">Highs around %1$s–%2$s</string>
    <string name="insight_highs_body">Above 180 in this window on about %1$d%% of days.</string>
    <string name="insight_highs_discuss">Commonly reviewed with the size and timing of the meal dose before it — or basal coverage if no meal is involved.</string>
    <string name="insight_dawn_title">Early-morning rise</string>
    <string name="insight_dawn_body">On %1$d of %2$d nights you rose about %3$d mg/dL between the 3–6 am low and 7 am, before breakfast.</string>
    <string name="insight_dawn_discuss">This \"dawn phenomenon\" comes from early-morning hormones. It\'s commonly discussed with the timing or amount of basal insulin.</string>
    <string name="insight_meal_title">%1$s · %2$d logged meals</string>
    <string name="insight_meal_body">Above 180 two hours later after %1$d of %2$d · low within 4 h after %3$d · average rise +%4$d mg/dL.</string>
    <string name="insight_meal_ratio">You used about 1 unit of rapid insulin per %1$s g of carbs.</string>
    <string name="insight_meal_discuss_high">Frequent highs after this meal are commonly discussed with this meal\'s carb ratio, the bolus timing, and carb counting.</string>
    <string name="insight_meal_discuss_low">Lows after this meal are commonly discussed with this meal\'s carb ratio — and double-checking carb counts.</string>
    <string name="insight_prebolus_title">Insulin timing before meals</string>
    <string name="insight_prebolus_body">With insulin 10+ min before eating, your meals rose +%1$d mg/dL on average (%2$d meals) vs +%3$d mg/dL when taken at or after eating (%4$d meals).</string>
    <string name="insight_stacking_title">Lows after back-to-back doses</string>
    <string name="insight_stacking_body">%1$d of your %2$d lows came within 4 h of two rapid doses taken less than 3 h apart.</string>
    <string name="insight_stacking_discuss">Rapid insulin keeps working for 3–5 hours, so overlapping doses add up (\"stacking\"). Many people check how much insulin is still active before a correction.</string>
    <string name="insight_formulas_title">Reference formulas (education)</string>
    <string name="insight_formulas_body">From your logged total daily dose of %1$s units (%2$d complete days): the 500 rule gives ≈1 unit per %3$s g of carbs; the 1800 rule gives ≈1 unit lowering %4$s mg/dL.</string>
    <string name="insight_formulas_note">These are population starting points clinicians use, not your prescription. If any dose wasn\'t logged, these numbers lean toward less insulin. Compare with your own plan and talk to your team before changing anything.</string>
    <string name="meal_breakfast">Breakfast</string>
    <string name="meal_lunch">Lunch</string>
    <string name="meal_dinner">Dinner</string>
    <string name="meal_late">Late night</string>
    <string name="insight_src_tir">International Consensus on Time in Range (Battelino et al., Diabetes Care 2019); GMI: Bergenstal et al., Diabetes Care 2018</string>
    <string name="insight_src_cv">International Consensus on Use of CGM (Danne et al., Diabetes Care 2017)</string>
    <string name="insight_src_lows">CGM low event = 15+ min below 70 mg/dL (Battelino et al., Diabetes Care 2019)</string>
    <string name="insight_src_dawn">Dawn phenomenon = rise of 20+ mg/dL (Monnier et al., Diabetes Care 2013)</string>
    <string name="insight_src_meal">Post-meal target under 180 mg/dL (ADA Standards of Care in Diabetes)</string>
