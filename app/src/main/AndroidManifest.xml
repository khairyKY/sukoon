<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CALL_PHONE (emergency escalation, A8) is intentionally not declared yet. -->

    <!-- Required to fire ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (see platform/BatteryOptimization.kt) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.NFC" />

    <!-- Gemini AI. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Direct Libre 2 connection over Bluetooth LE (data/source/libre/LibreBleSource.kt). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Location: BLE scanning before Android 12, and (optional) the map link in emergency texts. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Keeps the sensor connection alive in the background (platform/SensorService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarms (alarms/): urgent low takes over the screen and may bypass Do Not Disturb. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Emergency contacts (emergency/): text everyone and call the first one when an urgent low goes unanswered. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- required=false: SimulatedSource and future viewer-only clients don't need NFC hardware. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".SukoonApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Sukoon"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- ponytail: cleartext allowed app-wide because the Nightscout upload target is usually a
             self-hosted http URL on a LAN/Tailscale IP (Tailscale already encrypts the hop). Narrow
             it with a network-security-config if a public https-only Nightscout becomes the norm. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sukoon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write the meal photo for the AI carb estimate. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen glucose widget, resizable 1×1 up to half the screen (ui/widget/). -->
        <receiver
            android:name=".ui.widget.GlucoseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glucose_widget_info" />
        </receiver>

        <activity
            android:name=".ui.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Sukoon">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alarms.UrgentAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sukoon"
            android:turnScreenOn="true" />

        <receiver
            android:name=".alarms.AlarmActionReceiver"
            android:exported="false" />

        <service
            android:name=".platform.SensorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
