<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    BLE-stream / foreground-service / CALL_PHONE permissions are intentionally not declared yet —
    they belong to later Phase 1 (BLE) and Phase 2 (emergency-call) tasks.
    -->

    <!-- Required to fire ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (see platform/BatteryOptimization.kt) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.NFC" />
    <!-- required=false: SimulatedSource and future viewer-only clients don't need NFC hardware. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".SukoonApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.Sukoon"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sukoon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
