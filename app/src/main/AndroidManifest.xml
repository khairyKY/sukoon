<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    BLE/foreground-service/CALL_PHONE permissions are intentionally not declared yet — BLE
    streaming and emergency-call belong to other Phase 1/2 tasks, not this one.
    -->

    <uses-permission android:name="android.permission.NFC" />
    <!-- required=false: SimulatedSource and future viewer-only clients don't need NFC hardware. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.Sukoon"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sukoon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
